#: inc/main.php:197
msgid "I changed my logo. Purge the cached versions so visitors get the new one."
msgstr "He cambiado mi logotipo. Purga las versiones en caché para que los visitantes vean el nuevo."

#: inc/main.php:196
msgid "Offload my media library to the Optimole cloud to free up disk space."
msgstr "Externaliza mi biblioteca de medios a la nube de Optimole para liberar espacio en disco."

#: inc/main.php:195
msgid "Make my images load faster: turn on lazy loading and serve them at quality 80."
msgstr "Haz que mis imágenes carguen más rápido: activa la carga diferida y sírvelas con calidad 80."

#: inc/main.php:192
msgid "offload media to the cloud"
msgstr "externalizar medios a la nube"

#: inc/main.php:191
msgid "purge cached images"
msgstr "purgar imágenes en caché"

#: inc/main.php:190
msgid "make your images load faster"
msgstr "hacer que tus imágenes carguen más rápido"

#: inc/abilities.php:1145
msgid "Empty when done."
msgstr "Vacío cuando haya terminado."

#: inc/abilities.php:1128
msgid "Items handled in this call only."
msgstr "Elementos gestionados solo en esta llamada."

#: inc/abilities.php:1109
msgid "Maximum number of seconds to work before returning."
msgstr "Número máximo de segundos para trabajar antes de devolver."

#: inc/abilities.php:1105
msgid "Cursor returned by the previous call, to continue the same media_ids batch."
msgstr "Cursor devuelto por la llamada anterior, para continuar el mismo lote de media_ids."

#: inc/abilities.php:1048
msgid "Validate and return the changes without saving them."
msgstr "Valida y devuelve los cambios sin guardarlos."

#: inc/abilities.php:1006
msgid "Watermark ID from the Optimole dashboard, -1 to disable the watermark."
msgstr "ID de la marca de agua del escritorio de Optimole, -1 para desactivar la marca de agua."

#: inc/abilities.php:982
msgid "Used only when autoquality is disabled."
msgstr "Se usa solo cuando la calidad automática está desactivada."

#: inc/abilities.php:977
msgid "Legacy inverted flag: \"disabled\" means images are scaled to the visitor screen, \"enabled\" turns scaling off."
msgstr "Indicador invertido heredado: «disabled» significa que las imágenes se escalan a la pantalla del visitante, «enabled» desactiva el escalado."

#: inc/abilities.php:960
msgid "This site is not connected to Optimole."
msgstr "Este sitio no está conectado a Optimole."

