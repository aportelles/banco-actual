msgstr "El cursor no es un paso pendiente de esta importación."

#: includes/Abilities/Starter_Sites.php:538
msgid "Set confirm=true to import this starter site, or use dry_run=true to inspect the plan."
msgstr "Establece confirm=true para importar este sitio inicial, o usa dry_run=true para inspeccionar el plan."

#: includes/Abilities/Starter_Sites.php:532
msgid "Dry run, nothing was imported."
msgstr "Simulacro, no se importó nada."

#: includes/Abilities/Starter_Sites.php:482
msgid "This starter site requires an active premium license."
msgstr "El sitio inicial requiere una licencia premium activa."

